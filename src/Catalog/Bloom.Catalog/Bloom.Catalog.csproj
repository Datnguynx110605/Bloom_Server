<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IncludeGoogleApiCommonProtos>true</IncludeGoogleApiCommonProtos>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Protobuf Include="Protos\*.proto" GrpcServices="Server" />
    <InternalsVisibleTo Include="Bloom.Catalog.Tests" />
    <ProjectReference Include="..\Bloom.Catalog.Contracts\Bloom.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Bloom.Shared\Bloom.Shared.csproj" />
    <ProjectReference Include="..\..\Identity\Bloom.Identity.Contracts\Bloom.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Launch\Bloom.Launch.Contracts\Bloom.Launch.Contracts.csproj" />
    <ProjectReference Include="..\..\Order\Bloom.Order.Contracts\Bloom.Order.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
