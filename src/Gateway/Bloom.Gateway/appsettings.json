{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576,
      "MaxRequestHeadersTotalSize": 32768
    }
  },
  "Gateway": {
    "Mode": "api",
    "Redis": "gateway-redis:6379",
    "RabbitMq": "amqp://rabbitmq:5672",
    "JwksUrl": "http://identity:8080/.well-known/jwks.json",
    "AllowedOrigins": [
      "https://bloom.example"
    ],
    "RateLimits": {
      "global": {
        "Algorithm": "FixedWindow",
        "Key": "Ip",
        "Limit": 300,
        "WindowSeconds": 60
      },
      "auth": {
        "Algorithm": "SlidingWindow",
        "Key": "Ip",
        "Limit": 10,
        "WindowSeconds": 60
      },
      "refresh": {
        "Algorithm": "SlidingWindow",
        "Key": "Ip",
        "Limit": 20,
        "WindowSeconds": 60
      },
      "user": {
        "Algorithm": "TokenBucket",
        "Key": "User",
        "Burst": 60,
        "PerMinute": 120
      },
      "checkout": {
        "Algorithm": "TokenBucket",
        "Key": "User",
        "Burst": 3,
        "PerMinute": 6
      },
      "wr-join": {
        "Algorithm": "TokenBucket",
        "Key": "User",
        "Burst": 3,
        "PerMinute": 5
      },
      "wr-status": {
        "Algorithm": "TokenBucket",
        "Key": "User",
        "Burst": 5,
        "PerMinute": 30
      },
      "webhook": {
        "Algorithm": "FixedWindow",
        "Key": "Ip",
        "Limit": 600,
        "WindowSeconds": 60
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-public": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Metadata": {
          "Auth": "public-optional-user",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/admin/catalog/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "catalog_manager,support,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        },
        "Metadata": {
          "Auth": "public",
          "Policy": "auth"
        },
        "Timeout": "00:00:05"
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/auth/refresh",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Auth": "none",
          "Policy": "refresh",
          "CheckOrigin": "true"
        },
        "Timeout": "00:00:05"
      },
      "me": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/me/{**rest}"
        },
        "Metadata": {
          "Auth": "any-user",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-staff": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/admin/staff/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-audit": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/admin/audit/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "cart": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/cart/{**rest}"
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "reviews": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/reviews/{**rest}"
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "orders": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/orders/{**rest}"
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "checkout": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/checkout",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "checkout"
        },
        "Timeout": "00:00:15"
      },
      "admin-orders": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/admin/orders/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "support,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-coupons": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/admin/coupons/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "catalog_manager,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-settings": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/admin/settings/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "launch-public": {
        "ClusterId": "launch",
        "Match": {
          "Path": "/api/launches/{id}",
          "Methods": [
            "GET"
          ]
        },
        "Metadata": {
          "Auth": "public-optional-user",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "waiting-room-join": {
        "ClusterId": "launch",
        "Match": {
          "Path": "/api/launches/{id}/waiting-room",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "wr-join"
        },
        "Timeout": "00:00:05"
      },
      "waiting-room-status": {
        "ClusterId": "launch",
        "Match": {
          "Path": "/api/launches/{id}/waiting-room",
          "Methods": [
            "GET"
          ]
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "wr-status"
        },
        "Timeout": "00:00:05"
      },
      "admin-launches": {
        "ClusterId": "launch",
        "Match": {
          "Path": "/api/admin/launches/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "catalog_manager,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/admin/inventory/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "warehouse,catalog_manager,support,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/admin/payments/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "support,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "returns": {
        "ClusterId": "fulfillment",
        "Match": {
          "Path": "/api/returns/{**rest}"
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "warranty": {
        "ClusterId": "fulfillment",
        "Match": {
          "Path": "/api/warranty/{**rest}"
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "admin-fulfillment": {
        "ClusterId": "fulfillment",
        "Match": {
          "Path": "/api/admin/fulfillment/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "warehouse,support,admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/{**rest}"
        },
        "Metadata": {
          "Auth": "customer",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "notifications-hub": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/hub/{**rest}"
        },
        "Metadata": {
          "Auth": "none",
          "CheckOrigin": "true"
        },
        "TimeoutPolicy": "Disable"
      },
      "dlq-catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/admin/dlq/catalog/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/admin/dlq/inventory/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-launch": {
        "ClusterId": "launch",
        "Match": {
          "Path": "/api/admin/dlq/launch/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-order": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/admin/dlq/order/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/admin/dlq/payment/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-fulfillment": {
        "ClusterId": "fulfillment",
        "Match": {
          "Path": "/api/admin/dlq/fulfillment/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/admin/dlq/identity/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "dlq-notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/admin/dlq/notification/{**rest}"
        },
        "Metadata": {
          "Auth": "staff",
          "Roles": "admin",
          "Policy": "user"
        },
        "Timeout": "00:00:05"
      },
      "webhook-stripe": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/webhooks/stripe",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Auth": "none",
          "Policy": "webhook",
          "MaxBodyBytes": "262144"
        },
        "Timeout": "00:00:10"
      },
      "webhook-shippo": {
        "ClusterId": "fulfillment",
        "Match": {
          "Path": "/webhooks/shippo/{secret}",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Auth": "none",
          "Policy": "webhook",
          "MaxBodyBytes": "65536"
        },
        "Timeout": "00:00:10"
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://catalog:8080"
          }
        }
      },
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://identity:8080"
          }
        }
      },
      "order": {
        "Destinations": {
          "d1": {
            "Address": "http://order:8080"
          }
        }
      },
      "launch": {
        "Destinations": {
          "d1": {
            "Address": "http://launch:8080"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "d1": {
            "Address": "http://inventory:8080"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://payment:8080"
          }
        }
      },
      "fulfillment": {
        "Destinations": {
          "d1": {
            "Address": "http://fulfillment:8080"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://notification:8080"
          }
        }
      }
    }
  }
}
